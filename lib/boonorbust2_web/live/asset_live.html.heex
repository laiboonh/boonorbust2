<.tab_content class="min-h-screen bg-base-200">
  <div class="px-4 py-8">
    <div class="max-w-lg mx-auto">
      <%= if @is_admin do %>
        <div class="flex gap-3 mb-6">
          <button phx-click="new" class="flex-1 btn btn-primary btn-sm h-auto py-3">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6v6m0 0v6m0-6h6m-6 0H6"
              />
            </svg>
            Add Asset
          </button>

          <button
            phx-click="update_all_prices"
            disabled={@updating_prices or not @prices_due_for_update}
            class="flex-1 btn btn-info btn-sm h-auto py-3"
          >
            <svg
              class={["w-4 h-4 mr-1.5", @updating_prices && "animate-spin"]}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              />
            </svg>
            {if @updating_prices, do: "Updating...", else: "Update Prices & Dividends"}
          </button>
        </div>
      <% end %>

      <%= case @update_result do %>
        <% {:ok, message} -> %>
          <div role="alert" class="alert alert-success alert-soft mb-4">
            {message}
          </div>
        <% {:error, message} -> %>
          <div role="alert" class="alert alert-error alert-soft mb-4">
            {message}
          </div>
        <% nil -> %>
      <% end %>

      <%= if @update_failures != [] do %>
        <div role="alert" class="alert alert-warning alert-soft mb-4 text-sm items-start">
          <div>
            <p class="font-semibold mb-1">Failed items:</p>
            <ul class="list-disc list-inside">
              <%= for failure <- @update_failures do %>
                <li>{failure}</li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <!-- Filter Form -->
      <form phx-submit="filter" class="mb-4">
        <div class="flex gap-2">
          <input
            type="text"
            name="filter"
            value={@filter}
            placeholder="Search by asset name or tag..."
            class="flex-1 input input-primary input-sm"
          />
          <button type="submit" class="btn btn-primary btn-sm">
            Filter
          </button>
          <%= if @filter != "" do %>
            <button type="button" phx-click="clear_filter" class="btn btn-sm btn-outline">
              Clear
            </button>
          <% end %>
        </div>
      </form>

      <!-- Assets List -->
      <div id="assets-list" phx-update="stream" class="space-y-4">
        <div
          :for={{dom_id, asset} <- @streams.assets}
          id={dom_id}
          class="card bg-base-100 shadow-sm"
        >
          <div class="card-body p-4">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="mb-2">
                  <h3 class="font-semibold text-base-content">{asset.name}</h3>
                </div>
                <%= if asset.price do %>
                  <p class="text-xl font-bold text-base-content">
                    {asset.currency} {Decimal.to_string(asset.price)}
                  </p>
                <% else %>
                  <p class="text-base-content/50 italic">Price not set</p>
                <% end %>
                <p class="text-sm text-base-content/60 mt-2">
                  Updated
                  <span class="local-time" data-utc-time={DateTime.to_iso8601(asset.updated_at)}>
                    {Calendar.strftime(asset.updated_at, "%B %d, %Y at %I:%M %p")}
                  </span>
                </p>
                <% tags = Map.get(@asset_tags_map, asset.id, []) %>
                <%= if !Enum.empty?(tags) do %>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <%= for tag <- tags do %>
                      <span class="badge badge-info badge-soft badge-sm">
                        {tag.name}
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <div class="flex gap-2 ml-4">
                <button
                  phx-click="show_tags"
                  phx-value-id={asset.id}
                  class="text-accent hover:text-accent/70"
                  title="Manage tags"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                    >
                    </path>
                  </svg>
                </button>
                <%= if asset.distributes_dividends do %>
                  <button
                    phx-click="show_dividends"
                    phx-value-id={asset.id}
                    class="text-info hover:text-info/70"
                    title="View dividends"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      >
                      </path>
                    </svg>
                  </button>
                <% end %>
                <%= if @is_admin do %>
                  <button
                    phx-click="edit"
                    phx-value-id={asset.id}
                    class="text-primary hover:text-primary/70"
                    title="Edit asset"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                      >
                      </path>
                    </svg>
                  </button>
                  <button
                    phx-click="delete"
                    phx-value-id={asset.id}
                    data-confirm="Are you sure you want to delete this asset?"
                    class="text-error hover:text-error/70"
                    title="Delete asset"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      >
                      </path>
                    </svg>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Asset Modal -->
    <%= if @asset_in_progress do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-medium text-base-content">
              {if @asset_in_progress.id, do: "Edit Asset", else: "Add New Asset"}
            </h3>
            <button
              phx-click="close_modal"
              aria-label="Close"
              class="text-base-content/40 hover:text-base-content/70"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                >
                </path>
              </svg>
            </button>
          </div>

          <%= if @form_errors do %>
            <.form_errors changeset={@form_errors} />
          <% end %>

          <form
            phx-submit={if @asset_in_progress.id, do: "update", else: "save"}
            class="space-y-4"
          >
            <%= if @asset_in_progress.id do %>
              <input type="hidden" name="asset_id" value={@asset_in_progress.id} />
            <% end %>

            <div>
              <label for="asset_name" class="block text-sm font-medium text-base-content/80">
                Name
              </label>
              <input
                type="text"
                id="asset_name"
                name="asset[name]"
                value={@asset_in_progress.name}
                required
                class="mt-1 input input-primary w-full"
                placeholder="e.g. Apple Inc."
              />
            </div>

            <div>
              <label for="asset_price_url" class="block text-sm font-medium text-base-content/80">
                Price URL
              </label>
              <input
                type="text"
                id="asset_price_url"
                name="asset[price_url]"
                value={@asset_in_progress.price_url}
                class="mt-1 input input-primary w-full"
                placeholder="e.g. https://example.com/price"
              />
            </div>

            <div>
              <label for="asset_currency" class="block text-sm font-medium text-base-content/80">
                Currency
              </label>
              <select
                id="asset_currency"
                name="asset[currency]"
                required
                class="mt-1 select select-primary w-full"
              >
                <%= if @asset_in_progress.id do %>
                  <%= for {label, value} <- Boonorbust2.Currency.currency_options() do %>
                    <option value={value} selected={@asset_in_progress.currency == value}>
                      {label}
                    </option>
                  <% end %>
                <% else %>
                  <%= for {label, value} <- Boonorbust2.Currency.currency_options_with_default() do %>
                    <option value={value} selected={@asset_in_progress.currency == value}>
                      {label}
                    </option>
                  <% end %>
                <% end %>
              </select>
            </div>

            <div class="flex items-center">
              <input type="hidden" name="asset[distributes_dividends]" value="false" />
              <input
                type="checkbox"
                id="asset_distributes_dividends"
                name="asset[distributes_dividends]"
                value="true"
                checked={
                  @asset_in_progress.distributes_dividends == true or
                    @asset_in_progress.distributes_dividends == "true"
                }
                class="checkbox checkbox-primary checkbox-sm"
              />
              <label
                for="asset_distributes_dividends"
                class="ml-2 block text-sm text-base-content/80"
              >
                Distributes dividends
              </label>
            </div>

            <div>
              <label
                for="asset_dividend_url"
                class="block text-sm font-medium text-base-content/80"
              >
                Dividend URL
              </label>
              <input
                type="text"
                id="asset_dividend_url"
                name="asset[dividend_url]"
                value={@asset_in_progress.dividend_url}
                class="mt-1 input input-primary w-full"
                placeholder="e.g. https://example.com/dividends"
              />
            </div>

            <div>
              <label
                for="asset_dividend_withholding_tax"
                class="block text-sm font-medium text-base-content/80"
              >
                Dividend Withholding Tax
              </label>
              <select
                id="asset_dividend_withholding_tax"
                name="asset[dividend_withholding_tax]"
                class="mt-1 select select-primary w-full"
              >
                <option value="">Select rate</option>
                <option
                  value="0"
                  selected={@asset_in_progress.dividend_withholding_tax == "0"}
                >
                  0%
                </option>
                <option
                  value="0.05"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.05"}
                >
                  5%
                </option>
                <option
                  value="0.1"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.1"}
                >
                  10%
                </option>
                <option
                  value="0.15"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.15"}
                >
                  15%
                </option>
                <option
                  value="0.2"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.2"}
                >
                  20%
                </option>
                <option
                  value="0.25"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.25"}
                >
                  25%
                </option>
                <option
                  value="0.3"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.3"}
                >
                  30%
                </option>
                <option
                  value="0.35"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.35"}
                >
                  35%
                </option>
                <option
                  value="0.4"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.4"}
                >
                  40%
                </option>
                <option
                  value="0.45"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.45"}
                >
                  45%
                </option>
                <option
                  value="0.5"
                  selected={@asset_in_progress.dividend_withholding_tax == "0.5"}
                >
                  50%
                </option>
              </select>
            </div>

            <div class="flex gap-3 pt-4">
              <button
                type="submit"
                phx-disable-with={if @asset_in_progress.id, do: "Saving...", else: "Adding..."}
                class="flex-1 btn btn-primary"
              >
                {if @asset_in_progress.id, do: "Save", else: "Add Asset"}
              </button>
              <button type="button" phx-click="close_modal" class="flex-1 btn btn-secondary">
                Cancel
              </button>
            </div>
          </form>
        </div>
        <button class="modal-backdrop" phx-click="close_modal">Close</button>
      </div>
    <% end %>

    <!-- Dividends Modal -->
    <%= if @dividends_modal do %>
      <div class="modal modal-open">
        <div class="modal-box max-w-2xl">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-medium text-base-content">
              Dividends for {@dividends_modal.asset.name}
            </h3>
            <button
              phx-click="close_dividends_modal"
              aria-label="Close"
              class="text-base-content/40 hover:text-base-content/70"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                >
                </path>
              </svg>
            </button>
          </div>

          <%= if Enum.empty?(@dividends_modal.dividends) do %>
            <div class="text-center py-8 text-base-content/50">
              <p>No dividends recorded for this asset.</p>
            </div>
          <% else %>
            <div class="overflow-x-auto">
              <table class="table">
                <thead>
                  <tr>
                    <th>Ex-Date</th>
                    <th>Pay Date</th>
                    <th class="text-right">Value</th>
                    <th>Currency</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for dividend <- @dividends_modal.dividends do %>
                    <tr>
                      <td>
                        {Calendar.strftime(dividend.ex_date, "%B %d, %Y")}
                      </td>
                      <td>
                        <%= if dividend.pay_date do %>
                          {Calendar.strftime(dividend.pay_date, "%B %d, %Y")}
                        <% else %>
                          <span class="text-base-content/40 italic">N/A</span>
                        <% end %>
                      </td>
                      <td class="text-right font-medium">
                        {Decimal.to_string(dividend.value)}
                      </td>
                      <td>
                        {dividend.currency}
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

          <div class="mt-4 text-sm text-base-content/60 text-right">
            Total: {length(@dividends_modal.dividends)} {if length(@dividends_modal.dividends) ==
                                                              1,
                                                            do: "dividend",
                                                            else: "dividends"}
          </div>
        </div>
        <button class="modal-backdrop" phx-click="close_dividends_modal">Close</button>
      </div>
    <% end %>

    <!-- Tags Modal -->
    <%= if @tags_modal do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <div class="flex justify-between items-center mb-4 -mx-6 -mt-6 px-6 py-4 border-b border-base-200">
            <h2 class="text-lg font-bold text-base-content">
              Manage Tags - {@tags_modal.asset.name}
            </h2>
            <button
              phx-click="close_tags_modal"
              aria-label="Close"
              class="text-base-content/40 hover:text-base-content/70"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                >
                </path>
              </svg>
            </button>
          </div>
          <div class="mb-4">
            <h3 class="text-sm font-medium text-base-content/80 mb-2">Current Tags</h3>
            <%= if Enum.empty?(@tags_modal.tags) do %>
              <p class="text-sm text-base-content/60">No tags yet. Add one below.</p>
            <% else %>
              <div class="flex flex-wrap gap-2">
                <%= for tag <- @tags_modal.tags do %>
                  <span class="badge badge-info badge-soft gap-1">
                    {tag.name}
                    <button
                      phx-click="remove_tag"
                      phx-value-asset-id={@tags_modal.asset.id}
                      phx-value-tag-id={tag.id}
                      class="text-info hover:text-error"
                      title="Remove tag"
                    >
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M6 18L18 6M6 6l12 12"
                        >
                        </path>
                      </svg>
                    </button>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <% available_tags =
            Enum.reject(@tags_modal.all_tags, fn t ->
              t.id in Enum.map(@tags_modal.tags, & &1.id)
            end) %>
          <%= if !Enum.empty?(available_tags) do %>
            <div class="mb-4">
              <h3 class="text-sm font-medium text-base-content/80 mb-2">Available Tags</h3>
              <div class="flex flex-wrap gap-2">
                <%= for tag <- available_tags do %>
                  <button
                    type="button"
                    phx-click="add_existing_tag"
                    phx-value-tag-id={tag.id}
                    class="badge badge-neutral badge-soft hover:badge-info"
                  >
                    + {tag.name}
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
          <div>
            <h3 class="text-sm font-medium text-base-content/80 mb-2">Add New Tag</h3>
            <form phx-submit="add_tag" class="flex gap-2">
              <input
                type="text"
                name="tag_name"
                placeholder="Enter tag name"
                required
                class="flex-1 input input-primary input-sm"
              />
              <button type="submit" class="btn btn-primary btn-sm">
                Add
              </button>
            </form>
          </div>
        </div>
        <button class="modal-backdrop" phx-click="close_tags_modal">Close</button>
      </div>
    <% end %>

    <.tab_bar current_tab="assets">
      <:tab navigate={~p"/dashboard"} name="dashboard" icon="hero-home">
        Dashboard
      </:tab>
      <:tab navigate={~p"/positions?#{[filter: @filter]}"} name="positions" icon="hero-chart-bar">
        Positions
      </:tab>
      <:tab navigate={~p"/assets?#{[filter: @filter]}"} name="assets" icon="hero-squares-2x2">
        Assets
      </:tab>
      <:tab
        navigate={~p"/portfolio_transactions?#{[filter: @filter]}"}
        name="transactions"
        icon="hero-document-text"
      >
        Transactions
      </:tab>
      <:tab navigate={~p"/portfolios"} name="portfolios" icon="hero-folder">
        Portfolios
      </:tab>
    </.tab_bar>
  </div>
</.tab_content>
