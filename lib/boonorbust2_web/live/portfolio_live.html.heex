<.tab_content class="min-h-screen bg-base-200">
  <div class="px-4 py-8">
    <div class="max-w-lg mx-auto">
      <button phx-click="new" class="btn btn-primary btn-lg w-full mb-6">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 6v6m0 0v6m0-6h6m-6 0H6"
          />
        </svg>
        Add Portfolio
      </button>

      <div id="portfolios-list" phx-update="stream" class="space-y-4">
        <div
          :for={{dom_id, portfolio} <- @streams.portfolios}
          id={dom_id}
          class="card bg-base-100 shadow-sm"
        >
          <div class="card-body p-6">
            <div class="flex justify-between items-start mb-4">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-base-content">{portfolio.name}</h3>
                <%= if portfolio.description do %>
                  <p class="text-sm text-base-content/70 mt-1">{portfolio.description}</p>
                <% end %>
              </div>
              <div class="flex items-center gap-2">
                <button
                  phx-click="edit"
                  phx-value-id={portfolio.id}
                  class="text-info hover:text-info/70"
                  title="Edit"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                    >
                    </path>
                  </svg>
                </button>
                <button
                  phx-click="delete"
                  phx-value-id={portfolio.id}
                  data-confirm="Are you sure you want to delete this portfolio?"
                  class="text-error hover:text-error/70"
                  title="Delete"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                    >
                    </path>
                  </svg>
                </button>
              </div>
            </div>
            <%= if Map.get(portfolio, :tags, []) != [] do %>
              <div class="mt-4 flex flex-wrap gap-2">
                <%= for tag <- Map.get(portfolio, :tags, []) do %>
                  <span class="badge badge-info badge-soft">
                    {tag.name}: {percent_input_value(tag.target_allocation_percent)}%
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-base font-semibold text-base-content/80 mb-3">Tags</h2>
        <%= if @all_tags == [] do %>
          <p class="text-sm text-base-content/40">No tags yet.</p>
        <% else %>
          <div class="flex flex-wrap gap-2">
            <%= for tag <- @all_tags do %>
              <span class="badge badge-info badge-soft gap-1">
                {tag.name}
                <button
                  phx-click="delete_tag"
                  phx-value-id={tag.id}
                  data-confirm={"Delete tag \"#{tag.name}\"? It will be removed from all portfolios and assets."}
                  class="text-info hover:text-error focus:outline-none"
                  aria-label={"Delete tag #{tag.name}"}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 18L18 6M6 6l12 12"
                    />
                  </svg>
                </button>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%= if @portfolio_in_progress do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-medium text-base-content">
              {if @portfolio_in_progress.id, do: "Edit Portfolio", else: "Add New Portfolio"}
            </h3>
            <button
              phx-click="close_modal"
              aria-label="Close"
              class="text-base-content/40 hover:text-base-content/70"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                >
                </path>
              </svg>
            </button>
          </div>

          <%= if @form_errors do %>
            <.form_errors changeset={@form_errors} />
          <% end %>

          <form
            phx-submit={if @portfolio_in_progress.id, do: "update", else: "save"}
            class="space-y-4"
          >
            <%= if @portfolio_in_progress.id do %>
              <input type="hidden" name="portfolio_id" value={@portfolio_in_progress.id} />
            <% end %>

            <div>
              <label for="portfolio_name" class="block text-sm font-medium text-base-content/80">
                Name
              </label>
              <input
                type="text"
                id="portfolio_name"
                name="portfolio[name]"
                value={@portfolio_in_progress.name}
                required
                class="mt-1 input input-primary w-full"
                placeholder="My Portfolio"
              />
            </div>

            <div>
              <label
                for="portfolio_description"
                class="block text-sm font-medium text-base-content/80"
              >
                Description (optional)
              </label>
              <textarea
                id="portfolio_description"
                name="portfolio[description]"
                class="mt-1 textarea textarea-primary w-full"
                placeholder="Portfolio description..."
              >{@portfolio_in_progress.description}</textarea>
            </div>

            <div>
              <label class="block text-sm font-medium text-base-content/80">
                Tags (optional)
              </label>
              <div class="mt-1 space-y-2 max-h-56 overflow-y-auto border border-base-300 rounded-md p-2">
                <%= for tag <- @all_tags do %>
                  <% selected_tag =
                    Enum.find(Map.get(@portfolio_in_progress, :tags, []), &(&1.id == tag.id)) %>
                  <div class="flex items-center gap-2">
                    <input
                      type="checkbox"
                      id={"portfolio_tag_#{tag.id}"}
                      name="tag_ids[]"
                      value={tag.id}
                      checked={!!selected_tag}
                      class="checkbox checkbox-primary checkbox-sm"
                    />
                    <label
                      for={"portfolio_tag_#{tag.id}"}
                      class="flex-1 text-sm text-base-content/80"
                    >
                      {tag.name}
                    </label>
                    <input
                      type="number"
                      name={"tag_allocations[#{tag.id}]"}
                      value={
                        selected_tag &&
                          percent_input_value(selected_tag.target_allocation_percent)
                      }
                      min="0"
                      max="100"
                      step="0.01"
                      placeholder="%"
                      class="input input-primary input-sm w-20"
                    />
                    <span class="text-sm text-base-content/60">%</span>
                  </div>
                <% end %>
              </div>
              <p class="mt-1 text-sm text-base-content/60">
                Selected tags' target percentages must sum to 100.
              </p>
            </div>

            <div class="flex gap-3 pt-4">
              <button
                type="submit"
                phx-disable-with={
                  if @portfolio_in_progress.id, do: "Saving...", else: "Adding..."
                }
                class="flex-1 btn btn-primary"
              >
                {if @portfolio_in_progress.id, do: "Save", else: "Add Portfolio"}
              </button>
              <button type="button" phx-click="close_modal" class="flex-1 btn btn-secondary">
                Cancel
              </button>
            </div>
          </form>
        </div>
        <button class="modal-backdrop" phx-click="close_modal">Close</button>
      </div>
    <% end %>

    <.tab_bar current_tab="portfolios">
      <:tab navigate={~p"/dashboard"} name="dashboard" icon="hero-home">
        Dashboard
      </:tab>
      <:tab navigate={~p"/positions"} name="positions" icon="hero-chart-bar">
        Positions
      </:tab>
      <:tab navigate={~p"/assets"} name="assets" icon="hero-squares-2x2">
        Assets
      </:tab>
      <:tab navigate={~p"/portfolio_transactions"} name="transactions" icon="hero-document-text">
        Transactions
      </:tab>
      <:tab navigate={~p"/portfolios"} name="portfolios" icon="hero-folder">
        Portfolios
      </:tab>
    </.tab_bar>
  </div>
</.tab_content>
